---
import Container from "@components/container.astro";
import Cta from "@components/cta.astro";
import Hero from "@components/hero.astro";
import Layout from "@layouts/Layout.astro";
import heroImage from "assets/hero-talent.png";
import paraNoProgramadoresLogo from "assets/logos-desde0/para-no-programadores.png";
import paraPrincipiantesLogo from "assets/logos-desde0/para-principiantes.png";
import stackPersonalizadoLogo from "assets/logos-desde0/stack-personalizado.png";
import softwareEngineeringLogo from "assets/logos-desde0/software-engineering.png";
import kotlinMultiplatformLogo from "assets/logos-desde0/kotlin-multiplatform.png";
import Link from "@components/ui/link.astro";
import { Icon } from '@astrojs/starlight/components';
import Stages from "@components/stages/stages.astro";
import Stage from "@components/stages/stage.astro"
import Testimonies from "@components/testimonies.astro";
---
<script type="module" src="https://cdn.jsdelivr.net/npm/@justinribeiro/lite-youtube@1.5.0/lite-youtube.js"></script>
<Layout maxisterEnabled={true} seoProps={{
  title: "Programación Desde0 - Academia de Programación para Todos",
  description: "Aprende a programar desde cero absoluto hasta convertirte en desarrollador profesional con rutas prácticas y clases en vivo.",
  canonical: "https://desde0.jesusdmedinac.com",
  openGraph: {
    basic: {
      title: "Programación Desde0 - Academia de Programación para Todos",
      url: "https://desde0.jesusdmedinac.com",
      type: "website",
      image: "/hero-talent.png",
    },
  }
}}>
  <Container>
    {/* HERO 1: Para No Programadores */}
    <Hero
      title="Aprende a programar desde cero absoluto 🚀"
      subtitle="¿Nunca has escrito código? Te enseñamos paso a paso con analogías del mundo real, cero frustración y construyendo tu primera aplicación web completa (ShortURL). Clases en vivo los domingos ($200 MXN / sesión)."
      heroImage={paraNoProgramadoresLogo}
      heroAlt="Programación para no programadores Desde0"
    >
      <Link
        href="https://tally.so/r/7RrOeP"
        class="bg-paradiso text-white flex gap-1 items-center justify-center rounded-full"
        rel="noopener">
        Apartar mi lugar ($200 MXN)
        <Icon class="text-white w-5 h-5" name="right-arrow" />
      </Link>
      <Link
        size="lg"
        style="outline"
        rel="noopener"
        href="/roadmap/para-no-programadores/"
        class="border-charlotte bg-charlotte text-paradiso flex gap-1 items-center justify-center rounded-full">
        Ver temario y ruta
        <Icon class="w-4 h-4" name="seti:notebook" />
      </Link>
    </Hero>

    <Cta
      title="Convocatoria Abierta: Inicio Domingo 6 de Septiembre"
      message="24 semanas de formación guiada en vivo (9:00 - 11:00 AM o 4:00 - 6:00 PM) con Diploma Oficial de Participación."
    >
      <Link href="https://tally.so/r/7RrOeP" style="inverted" class="rounded-full">Inscribirme ahora</Link>
    </Cta>

    {/* SECCIÓN DE RUTAS / TALLERES */}
    <Stages
      title="Rutas de aprendizaje para cada etapa de tu carrera">
      <Stage
          title="Para no programadores"
          description="Da tus primeros pasos en el desarrollo de software. Construye bases sólidas con analogías claras, aprende desarrollo web y crea el proyecto ShortURL."
          primaryRef="https://tally.so/r/7RrOeP"
          secondaryRef="/roadmap/para-no-programadores/"
          picture={paraNoProgramadoresLogo}
      ></Stage>
      <Stage
        title="Para principiantes (Juniors)"
        description="Si ya decidiste a qué te quieres dedicar, ahora debes incrementar tu valor al perfeccionar las habilidades que aumentarán tu empleabilidad. Domina las técnicas de desarrollo de software más utilizadas y comienza a compartir lo que sabes con el mundo."
        picture={paraPrincipiantesLogo}
        primaryRef="https://tally.so/r/7RrOeP"
        secondaryRef="/roadmap/para-principiantes/1"
      ></Stage>
      <Stage
        title="Elige tu Stack personalizado"
        description="Elegir una especialidad te destacará del resto. Android, iOS, Frontend, Backend, Desktop. Cada Stack tiene una ruta personalizada para ti. Aprenderás los lenguajes de programación, técnicas de desarrollo y administración de base de datos."
        picture={stackPersonalizadoLogo}
        primaryRef="https://tally.so/r/7RrOeP"
        secondaryRef="/roadmap/stack-personalizado/1"
      ></Stage>
      <Stage
        title="Software Engineering"
        description="Desde principios básicos como YAGNI, DRY, SOLID hasta técnicas de desarrollo avanzadas como TDD, DDD y Clean Code o Clean Architecture. Cambia tu manera de pensar y de trabajar en equipos de alto rendimiento. Destácate por tus habilidades sociales."
        picture={softwareEngineeringLogo}
        primaryRef="https://tally.so/r/7RrOeP"
        secondaryRef="/roadmap/software-engineering/1"
      ></Stage>
    </Stages>

    {/* HERO 2: Kotlin para Principiantes */}
    <Hero
      title="Kotlin para Principiantes ⚡"
      subtitle="Domina el lenguaje moderno de JetBrains para Android, backend y multiplataforma. Aprende de forma agnóstica a la plataforma y construye un asistente AI Chat CLI paso a paso en clases en vivo o a tu propio ritmo."
      heroImage={kotlinMultiplatformLogo}
      heroAlt="Kotlin para Principiantes"
    >
      <Link
        href="https://kotlin-0-dev.jesusdmedinac.com/"
        class="bg-paradiso text-white flex gap-1 items-center justify-center rounded-full"
        rel="noopener">
        Explorar curso de Kotlin
        <Icon class="text-white w-5 h-5" name="right-arrow" />
      </Link>
      <Link
        size="lg"
        style="outline"
        rel="noopener"
        href="https://tally.so/r/GxAj5o"
        class="border-charlotte bg-charlotte text-paradiso flex gap-1 items-center justify-center rounded-full">
        Apartar lugar en vivo ($600 MXN)
        <Icon class="w-4 h-4" name="seti:notebook" />
      </Link>
    </Hero>

    <Cta
      title="¿Tienes dudas sobre qué ruta elegir?"
      message="Únete a nuestra comunidad en Discord y recibe orientación personalizada de mentores y compañeros."
    >
      <Link href="https://discord.gg/nChTf3PdGJ" style="inverted" class="rounded-full">Unirme a Discord</Link>
    </Cta>
  </Container>
</Layout>
